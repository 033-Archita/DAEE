# Required: MongoDB Atlas connection string. Store real credentials only in .env
# locally or GitHub Actions secrets; never put them in this template.
MONGO_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGO_DATABASE=daily_curiosity

# Application settings
APP_ENV=development
LOG_LEVEL=INFO
TIMEZONE=Asia/Kolkata
POOL_SIZE=50
LOW_WATERMARK=15

# LLM routing. Replace placeholders locally; leave a provider key unset to disable it.
LLM_PROVIDER_ORDER=groq,mistral
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
MISTRAL_API_KEY=
MISTRAL_MODEL=mistral-small-latest

# Web research (Phases 5 and 7). Create a Tavily API key and set it here.
TAVILY_API_KEY=
TAVILY_MAX_RESULTS=5

# Gmail API OAuth (Phases 9–10). Create an OAuth Desktop client and refresh token.
GMAIL_OAUTH_CLIENT_ID=
GMAIL_OAUTH_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=
GMAIL_RECIPIENT=you@example.com
